{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://h5p-arch-desk/arch-file.schema.json",
  "title": "h5p-arch-desk 架构描述文件",
  "description": "一个描述文件（YAML 或 JSON）的结构。各顶层键均可选、可组合；跨文件引用由 validate 检查。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "system": {
      "$ref": "#/definitions/system"
    },
    "module": {
      "$ref": "#/definitions/module"
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/module"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/relation"
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/interface"
      }
    },
    "dataStructures": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/dataStructure"
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/actor"
      }
    },
    "scenario": {
      "$ref": "#/definitions/scenario"
    },
    "scenarios": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/scenario"
      }
    },
    "sourceIgnore": {
      "$ref": "#/definitions/textList",
      "description": "忽略清单（G8）：不属于任何模块的源码文件，glob 相对源码根目录"
    },
    "sourceLimits": {
      "type": "object",
      "additionalProperties": false,
      "description": "源码限制（G20）：maxLines 为超长阈值，缺省 500；只能声明一次",
      "properties": {
        "maxLines": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "description": "架构规则（U1–U5、Y3）：架构师的意图，约定写在 rules.yaml，只能声明一次；AI 重新生成当前版本时不改动",
      "properties": {
        "layers": {
          "type": "boolean",
          "description": "层规则开关（U2），缺省 true：层按 mayDependOn 默认拒绝"
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "module"
            ],
            "properties": {
              "module": {
                "$ref": "#/definitions/id"
              },
              "mayDependOn": {
                "$ref": "#/definitions/idList",
                "description": "依赖白名单（U3）：子树之外只许依赖这些模块的子树"
              },
              "exposes": {
                "$ref": "#/definitions/textList",
                "description": "访问面（U4）：子树之外只许经这些文件访问；glob 相对源码根目录，entry 表示模块入口"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "$ref": "#/definitions/id"
              },
              "to": {
                "$ref": "#/definitions/id"
              },
              "rule": {
                "enum": [
                  "layer",
                  "deps",
                  "exposes"
                ]
              },
              "reason": {
                "type": "string",
                "description": "必填（U1）"
              }
            }
          }
        },
        "cycles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tolerated": {
              "$ref": "#/definitions/idList",
              "description": "容忍的环（Y3）：环的全部成员都在这些子树内时不计入门禁"
            }
          }
        }
      }
    },
    "reviewed": {
      "type": "array",
      "description": "确认记录（Z1–Z6，ADR-0023）：架构师确认过的模块，约定写在 reviewed.yaml，由页面与草图归档写入；AI 重新生成当前版本时不改动",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module",
          "at",
          "hash"
        ],
        "properties": {
          "module": {
            "$ref": "#/definitions/id"
          },
          "at": {
            "type": "string",
            "description": "确认日期 YYYY-MM-DD"
          },
          "hash": {
            "type": "string",
            "description": "确认内容的指纹（Z2）"
          },
          "source": {
            "type": "string",
            "pattern": "^(manual|sketch:[A-Za-z0-9][A-Za-z0-9._:-]*)$",
            "description": "来源（Z6）：manual 或 sketch:<设计 ID>"
          },
          "note": {
            "type": "string",
            "description": "架构师自己的话（可选）"
          },
          "summary": {
            "type": "object",
            "additionalProperties": false,
            "description": "确认时的摘要（Z3）：需复核时据此显示差异",
            "properties": {
              "responsibility": {
                "type": "string"
              },
              "includes": {
                "$ref": "#/definitions/textList"
              },
              "excludes": {
                "$ref": "#/definitions/textList"
              },
              "mayDependOn": {
                "$ref": "#/definitions/idList"
              },
              "provides": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "#/definitions/id"
                    },
                    "signature": {
                      "type": "string"
                    }
                  }
                }
              },
              "children": {
                "$ref": "#/definitions/idList"
              }
            }
          }
        }
      }
    },
    "sketch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mount"
      ],
      "description": "草图（X1、X2、X9，ADR-0023、ADR-0025）：人拥有的局部描述，只在 intent/*.yaml 与 designs/<设计>/sketches/<mount>.yaml 里用；一张草图挂在一个模块下、只画一个层次，内容与普通描述同形，没写的字段不约束",
      "properties": {
        "id": {
          "$ref": "#/definitions/id",
          "description": "持久草图有固定 ID（骨架为 skeleton）；设计的草图 ID 即设计 ID"
        },
        "mount": {
          "$ref": "#/definitions/id",
          "description": "挂载点（X9）：模块 ID 或 root；不能是层。非根草图的模块是挂载点的直接子节点，根挂载为层与层的直接子模块"
        },
        "lifetime": {
          "enum": [
            "persistent",
            "until-implemented"
          ],
          "description": "生命周期（X3）：intent/ 下缺省 persistent，设计的草图缺省 until-implemented"
        },
        "closed": {
          "$ref": "#/definitions/idList",
          "description": "封闭的子树（X2）：这些草图模块的直接子模块集合必须与草图相等"
        },
        "supersedes": {
          "$ref": "#/definitions/id",
          "description": "定稿实现后替换的持久草图 ID（晋升，X3）"
        },
        "abstraction": {
          "type": "string",
          "description": "挂载点模块对内的原则（X10），加载为挂载点模块的 abstraction；根挂载不用，改用各层的 abstraction 等字段"
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/sketchModule"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/relation"
          }
        },
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/interface"
          }
        },
        "dataStructures": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/dataStructure"
          }
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "description": "布局（X15、X22）：本层模块的坐标（非根草图相对中心区的内容原点；引用节点不记，读到的旧坐标忽略、保存时去掉）与关系标签位置；人拥有，随草图归档",
          "properties": {
            "modules": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/definitions/id"
              },
              "additionalProperties": {
                "$ref": "#/definitions/spot"
              }
            },
            "relations": {
              "type": "object",
              "propertyNames": {
                "$ref": "#/definitions/id"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "$ref": "#/definitions/point"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "idList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/id"
      }
    },
    "text": {
      "type": "string"
    },
    "textList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repo": {
              "type": "string"
            },
            "commit": {
              "type": "string"
            },
            "generatedAt": {
              "type": "string"
            },
            "history": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "days": {
                  "type": "integer",
                  "minimum": 1
                },
                "fixPatterns": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "coupling": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "min": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "ratio": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "$ref": "#/definitions/id"
        },
        "kind": {
          "type": "string"
        },
        "status": {
          "enum": [
            "current",
            "target",
            "deprecated"
          ]
        },
        "core": {
          "type": "boolean"
        },
        "role": {
          "description": "角色（02 §1.1、ADR-0027）：core 核心 / shared 共用件 / bus 事件总线（不作 notifies 的端点，M14）；不写为普通",
          "enum": [
            "core",
            "shared",
            "bus"
          ]
        },
        "responsibility": {
          "type": "string"
        },
        "principle": {
          "type": "string"
        },
        "dataStructures": {
          "$ref": "#/definitions/idList"
        },
        "provides": {
          "$ref": "#/definitions/idList"
        },
        "codeRefs": {
          "$ref": "#/definitions/textList"
        },
        "entry": {
          "type": "string",
          "description": "对外入口文件，相对源码根目录；不写时按约定推出（G10）"
        },
        "docRefs": {
          "$ref": "#/definitions/textList"
        },
        "owner": {
          "type": "string"
        },
        "tags": {
          "$ref": "#/definitions/textList"
        },
        "order": {
          "type": "number"
        },
        "abstraction": {
          "type": "string"
        },
        "includes": {
          "$ref": "#/definitions/textList"
        },
        "excludes": {
          "$ref": "#/definitions/textList"
        },
        "mayDependOn": {
          "$ref": "#/definitions/idList"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/module"
          }
        },
        "designNote": {
          "type": "string",
          "description": "设计版本专用：为什么这样设计 / 调整（Markdown）"
        }
      }
    },
    "sketchModule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "$ref": "#/definitions/id"
        },
        "kind": {
          "type": "string"
        },
        "status": {
          "enum": [
            "current",
            "target",
            "deprecated"
          ]
        },
        "core": {
          "type": "boolean"
        },
        "role": {
          "description": "角色（02 §1.1、ADR-0027）：core 核心 / shared 共用件 / bus 事件总线（不作 notifies 的端点，M14）；不写为普通",
          "enum": [
            "core",
            "shared",
            "bus"
          ]
        },
        "responsibility": {
          "type": "string"
        },
        "principle": {
          "type": "string"
        },
        "dataStructures": {
          "$ref": "#/definitions/idList"
        },
        "provides": {
          "$ref": "#/definitions/idList"
        },
        "codeRefs": {
          "$ref": "#/definitions/textList"
        },
        "entry": {
          "type": "string",
          "description": "对外入口文件，相对源码根目录；不写时按约定推出（G10）"
        },
        "docRefs": {
          "$ref": "#/definitions/textList"
        },
        "owner": {
          "type": "string"
        },
        "tags": {
          "$ref": "#/definitions/textList"
        },
        "order": {
          "type": "number"
        },
        "abstraction": {
          "type": "string"
        },
        "includes": {
          "$ref": "#/definitions/textList"
        },
        "excludes": {
          "$ref": "#/definitions/textList"
        },
        "mayDependOn": {
          "$ref": "#/definitions/idList"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/sketchModule"
          }
        },
        "designNote": {
          "type": "string",
          "description": "设计版本专用：为什么这样设计 / 调整（Markdown）"
        },
        "from": {
          "$ref": "#/definitions/idList",
          "description": "血缘（X11）：这个模块由哪些基线模块而来，一律指向基线 ID；全新模块不写"
        }
      },
      "description": "草图里的模块（X9、X11）：字段同普通模块，可带血缘 from"
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "from": {
          "$ref": "#/definitions/id"
        },
        "to": {
          "$ref": "#/definitions/id"
        },
        "type": {
          "description": "关系类型（02 §1.1、ADR-0022、ADR-0026）：关系是交互，运行时关系的箭头是控制流方向；depends 已不是关系类型（M15，读取时丢弃并提醒）。event / dataflow 是已弃用的旧名（M12），加载时映射为 notifies（翻转 from / to）/ streams 并提醒迁移",
          "anyOf": [
            {
              "enum": [
                "calls",
                "notifies",
                "streams",
                "implements"
              ]
            },
            {
              "enum": [
                "event",
                "dataflow"
              ],
              "deprecated": true
            }
          ]
        },
        "pull": {
          "description": "只用于 streams：拉取型流，箭头仍指数据去向（M13）",
          "type": "boolean"
        },
        "mode": {
          "description": "同步性：对 calls 区分同步命令与异步命令（Promise、异步回调、postMessage、定时器回调，ADR-0026）；不写为同步",
          "enum": [
            "sync",
            "async"
          ]
        },
        "via": {
          "enum": [
            "http",
            "hmr",
            "inject",
            "router",
            "callback",
            "port",
            "bus"
          ]
        },
        "interface": {
          "$ref": "#/definitions/id"
        },
        "payload": {
          "oneOf": [
            {
              "$ref": "#/definitions/id"
            },
            {
              "$ref": "#/definitions/idList"
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "designNote": {
          "type": "string",
          "description": "设计版本专用：为什么这样设计 / 调整（Markdown）"
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string"
        },
        "owner": {
          "$ref": "#/definitions/id"
        },
        "signature": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "semantics": {
          "type": "string"
        },
        "designNote": {
          "type": "string",
          "description": "设计版本专用：为什么这样设计 / 调整（Markdown）"
        }
      }
    },
    "dataStructure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "invariants": {
          "type": "string"
        },
        "designNote": {
          "type": "string",
          "description": "设计版本专用：为什么这样设计 / 调整（Markdown）"
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind"
      ],
      "description": "外部参与者：系统之外主动发起交互的实体，不进模块树（规则 A1–A5）",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "user",
            "system",
            "time"
          ],
          "description": "user 人的操作 / system 外部系统主动调用或推送 / time 定时与超时"
        },
        "description": {
          "type": "string"
        },
        "designNote": {
          "type": "string",
          "description": "设计版本专用：为什么这样设计 / 调整（Markdown）"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "steps"
      ],
      "description": "一条有名字的执行链路；不写默认层次与触发者（规则 S9、A6）",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "cause": {
          "type": "string",
          "description": "触发原因（文字）"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "证据文件：验证这条链路的测试、E2E 等源码文件路径（相对源码根目录）；只校验在源码清单里存在，不解析内容（S15）"
        },
        "steps": {
          "$ref": "#/definitions/steps"
        },
        "designNote": {
          "type": "string",
          "description": "设计版本专用：为什么这样设计 / 调整（Markdown）"
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/step"
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/id",
          "description": "场景内唯一；写了则帧 ID 稳定（F2、S11）"
        },
        "from": {
          "$ref": "#/definitions/id"
        },
        "to": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "type": "string"
        },
        "relation": {
          "$ref": "#/definitions/id",
          "description": "对应的结构关系（S12、S13）"
        },
        "interface": {
          "$ref": "#/definitions/id"
        },
        "payload": {
          "oneOf": [
            {
              "$ref": "#/definitions/id"
            },
            {
              "$ref": "#/definitions/idList"
            }
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "step": {
