          { "op": "edit", "sketch": "{{sketch.mount}}", "edit": { "op": "addModule", "parent": "{{sketch.mount}}", "name": "运行派生", "id": "derived" } },
          {
            "op": "edit",
            "sketch": "{{sketch.mount}}",
            "edit": { "op": "connect", "from": "{{sketch.mount}}.derived", "to": "{{sketch.mount}}.loading", "type": "queries", "description": "读描述" }
          }
        ]
      }
    },
    { "done": true }
  ]
