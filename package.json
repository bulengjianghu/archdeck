{
  "name": "h5p-arch-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "h5player 架构可视化：按层次浏览模块与模块间关系",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "type-check": "vue-tsc --build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "lint:model": "vite-node scripts/lint-model.ts --"
  },
  "dependencies": {
    "@shikijs/langs": "^3.23.0",
    "@shikijs/themes": "^3.23.0",
    "@vue-flow/core": "^1.48.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "elkjs": "^0.11.0",
    "markdown-it": "^14.1.0",
    "shiki": "^3.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tsconfig/node22": "^22.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.13.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.9",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.1.0",
    "vite-node": "^3.0.5",
    "vitest": "^3.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.2"
  }
}
